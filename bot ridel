<script>

const $ = id => document.getElementById(id);

let voiceOn = true;

const K='btc-entrada-anticipada-nuevo-stats-v2';
const BK='btc-entrada-anticipada-cerebrito-v2';

function getBrain(){

  let b={
    history:[],
    patternScore:{},
    good:0,
    bad:0
  };

  try{
    b=JSON.parse(localStorage.getItem(BK))||b;
  }catch(e){}

  b.history ||= [];
  b.patternScore ||= {};
  b.good ||= 0;
  b.bad ||= 0;

  return b;
}

function saveBrain(b){
  localStorage.setItem(BK,JSON.stringify(b));
}

function currentSide(){

  const t=($('mainSignal')?.textContent||'').toUpperCase();

  if(t.includes('DOWN')) return 'DOWN';

  if(t.includes('UP')) return 'UP';

  return 'ESPERAR';
}

function currentPattern(){

  return $('patternNow')?.textContent ||
         $('lastCandle')?.textContent ||
         'SIN PATRÓN';
}

function loadBrain(){

  const b=getBrain();

  $('goodPatterns').textContent=b.good||0;
  $('badPatterns').textContent=b.bad||0;

  const pattern=currentPattern();

  const ps=b.patternScore[pattern]||{
    wins:0,
    losses:0,
    profit:0,
    weight:1
  };

  $('brainPattern').textContent=pattern;

  $('brainWeight').textContent=
    Number(ps.weight||1).toFixed(2)+'×';

  $('brainLog').innerHTML=
    b.history.slice(-8).reverse().map(x=>

      `<div class="logline">
      ${x.type==='profit'
        ?'💰 PROFIT'
        :(x.win?'✅ GANADA':'❌ PERDIDA')}
      · ${x.pattern}
      · ${x.side}
      </div>`

    ).join('')
    ||
    '<div class="logline">Todavía no hay rondas clasificadas.</div>';
}

function loadStats(){

  let s={
    r:0,
    w:0,
    l:0,
    p:0
  };

  try{
    s=JSON.parse(localStorage.getItem(K))||s;
  }catch(e){}

  $('rounds').textContent=s.r||0;
  $('wins').textContent=s.w||0;
  $('losses').textContent=s.l||0;
  $('profits').textContent=s.p||0;

  $('learned').textContent=s.r||0;

  $('learnAccuracy').textContent=
    s.r
    ?Math.round(((s.w||0)/s.r)*100)+'%'
    :'—';
}

function saveResult(win,type='win'){

  let s={
    r:0,
    w:0,
    l:0,
    p:0
  };

  try{
    s=JSON.parse(localStorage.getItem(K))||s;
  }catch(e){}

  s.r++;

  if(win){
    s.w++;

    if(type==='profit'){
      s.p++;
    }

  }else{
    s.l++;
  }

  localStorage.setItem(K,JSON.stringify(s));

  const b=getBrain();

  const pattern=currentPattern();
  const side=currentSide();

  if(!b.patternScore[pattern]){

    b.patternScore[pattern]={
      wins:0,
      losses:0,
      profit:0,
      weight:1
    };
  }

  const ps=b.patternScore[pattern];

  if(win){

    ps.wins++;

    if(type==='profit'){
      ps.profit++;
      ps.weight=Math.min(2,ps.weight+0.10);
    }else{
      ps.weight=Math.min(2,ps.weight+0.08);
    }

    b.good++;

  }else{

    ps.losses++;
    ps.weight=Math.max(.25,ps.weight-.08);
    b.bad++;
  }

  b.history.push({
    ts:Date.now(),
    win,
    type,
    pattern,
    side,
    weight:ps.weight
  });

  if(b.history.length>300){
    b.history=b.history.slice(-300);
  }

  saveBrain(b);

  loadStats();
  loadBrain();

  if(voiceOn && 'speechSynthesis' in window){

    let msg;

    if(type==='profit'){

      msg=
      'Profit guardado como ronda ganada. El cerebrito reforzó este patrón.';

    }else if(win){

      msg=
      'Ronda guardada como ganada. El cerebrito reforzó este patrón.';

    }else{

      msg=
      'Ronda guardada como perdida. El cerebrito reducirá el peso de este patrón.';
    }

    const u=new SpeechSynthesisUtterance(msg);

    u.lang='es-US';

    speechSynthesis.cancel();
    speechSynthesis.speak(u);
  }
}

function toggleVoice(){

  voiceOn=!voiceOn;

  $('voiceBtn').textContent=
    voiceOn
    ?'🔊 VOZ ACTIVADA'
    :'🔇 VOZ APAGADA';
}

let up=63;

function demoShift(){

  up=
    up===63
    ?48
    :(up===48?68:63);

  const down=100-up;

  $('upNum').textContent=up+'%';

  $('downNum').textContent=down+'%';

  $('upBar').style.width=up+'%';

  $('downBar').style.width=down+'%';

  if(up>=60){

    $('earlySignal').textContent=
      'ENTRAR UP · '+Math.max(40,up-21)+'%';

    $('earlySignal').className=
      'earlysignal up';

    $('mainSignal').textContent=
      'UP EN DESARROLLO';

    $('mainSignal').className=
      'signal up';

    $('reason').textContent=
      'Técnica + memoria favorecen UP';

    $('confirm').textContent=
      'UP CONFIRMADO';

    $('confirm').className=
      'confirm up';

  }else{

    $('earlySignal').textContent=
      'ESPERAR ENTRADA';

    $('earlySignal').className=
      'earlysignal wait';

    $('mainSignal').textContent=
      'ESPERAR';

    $('mainSignal').className=
      'signal wait';

    $('reason').textContent=
      'La señal todavía no tiene confirmación suficiente';

    $('confirm').textContent=
      'ESPERAR CONFIRMACIÓN';

    $('confirm').className=
      'confirm wait';
  }
}

let sec=8*60+42;

function updateTimer(){

  sec--;

  if(sec<0){
    sec=14*60+59;
  }

  const m=Math.floor(sec/60);
  const s=sec%60;

  $('timer').textContent=
    String(m).padStart(2,'0')
    +':'+
    String(s).padStart(2,'0');
}

document.addEventListener('DOMContentLoaded',()=>{

  loadStats();

  loadBrain();

  setInterval(updateTimer,1000);

});

</script>

