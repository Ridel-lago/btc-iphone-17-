<!doctype html>
<html lang="es">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover">
<meta name="theme-color" content="#07111f">
<title>BTC · Entrada Anticipada</title>

<style>
:root{
  --bg:#07111f;
  --card:#0d1a2b;
  --card2:#101f33;
  --line:#20344e;
  --text:#f7fbff;
  --muted:#8fa7c0;
  --green:#23d18b;
  --red:#ff5f6d;
  --yellow:#ffd166;
  --blue:#53a7ff;
}

*{box-sizing:border-box}

body{
  margin:0;
  background:linear-gradient(180deg,#06101d,#0a1422 55%,#07111f);
  color:var(--text);
  font-family:-apple-system,BlinkMacSystemFont,"Segoe UI",Roboto,Arial,sans-serif
}

.wrap{
  max-width:760px;
  margin:auto;
  padding:14px 12px 40px
}

.top{
  display:flex;
  justify-content:space-between;
  align-items:center;
  gap:10px;
  margin:4px 0 12px
}

.brand{
  font-size:21px;
  font-weight:900;
  letter-spacing:.2px
}

.badge{
  font-size:12px;
  border:1px solid var(--line);
  background:#0b1726;
  padding:7px 10px;
  border-radius:999px;
  color:#bcd0e5
}

.card{
  background:linear-gradient(180deg,var(--card2),var(--card));
  border:1px solid var(--line);
  border-radius:18px;
  padding:14px;
  margin:10px 0;
  box-shadow:0 12px 28px rgba(0,0,0,.22)
}

.grid2{
  display:grid;
  grid-template-columns:1fr 1fr;
  gap:10px
}

.label{
  font-size:11px;
  color:var(--muted);
  text-transform:uppercase;
  letter-spacing:.8px
}

.value{
  font-size:24px;
  font-weight:900;
  margin-top:4px
}

.small{
  font-size:13px;
  color:var(--muted)
}

.center{text-align:center}

.round{
  font-size:46px;
  font-weight:1000;
  line-height:1
}

.signal{
  font-size:34px;
  font-weight:1000;
  margin:6px 0
}

.wait{color:var(--yellow)}
.up{color:var(--green)}
.down{color:var(--red)}

.probs{
  display:grid;
  grid-template-columns:1fr 1fr;
  gap:10px;
  margin-top:12px
}

.prob{
  border-radius:16px;
  padding:13px;
  border:1px solid var(--line);
  background:#0a1625
}

.prob .n{
  font-size:32px;
  font-weight:1000
}

.bar{
  height:9px;
  background:#16283c;
  border-radius:999px;
  overflow:hidden;
  margin-top:8px
}

.fill{
  height:100%;
  border-radius:999px
}

.upfill{background:var(--green)}
.downfill{background:var(--red)}

.earlybox{
  margin:12px 0 2px;
  padding:14px;
  border-radius:16px;
  border:1px solid #2f7f67;
  background:#0c2a24;
  text-align:center
}

.earlytitle{
  font-size:12px;
  color:#9de8ca;
  text-transform:uppercase;
  letter-spacing:1px;
  font-weight:900
}

.earlysignal{
  font-size:28px;
  font-weight:1000;
  margin-top:5px
}

.earlymeta{
  font-size:13px;
  color:#b7d7ca;
  margin-top:5px
}

.confirm{
  padding:12px;
  border-radius:14px;
  border:1px solid #42516a;
  background:#121c2a;
  font-weight:900;
  text-align:center;
  font-size:19px
}

.row{
  display:flex;
  justify-content:space-between;
  gap:8px;
  align-items:center;
  padding:9px 0;
  border-bottom:1px solid rgba(255,255,255,.06)
}

.row:last-child{border-bottom:0}

.pill{
  font-size:12px;
  padding:5px 8px;
  border-radius:999px;
  background:#13263a;
  color:#c8d8e8
}

.actions{
  display:grid;
  grid-template-columns:1fr 1fr;
  gap:9px;
  margin-top:10px
}

button{
  border:0;
  border-radius:14px;
  padding:13px 10px;
  font-weight:850;
  font-size:15px;
  background:#17304a;
  color:white
}

button.primary{background:#1a6fd1}
button.good{background:#145d45}
button.bad{background:#7d2630}

.memory{
  display:grid;
  grid-template-columns:repeat(4,1fr);
  gap:8px
}

.stat{
  background:#0a1625;
  border:1px solid var(--line);
  border-radius:14px;
  padding:11px;
  text-align:center
}

.stat b{
  display:block;
  font-size:22px;
  margin-top:3px
}

.alert{
  border:1px solid #6a5521;
  background:#2c240f;
  color:#ffe7a5;
  border-radius:14px;
  padding:10px 12px;
  font-size:13px
}

.footer{
  font-size:11px;
  color:#71879e;
  text-align:center;
  margin-top:14px
}

.bookgrid{
  display:grid;
  grid-template-columns:1fr 1fr;
  gap:8px;
  margin-top:10px
}

.bookitem{
  background:#0a1625;
  border:1px solid var(--line);
  border-radius:13px;
  padding:10px
}

.bookitem b{
  display:block;
  font-size:13px;
  margin-bottom:3px
}

.bookitem span{
  font-size:11px;
  color:var(--muted)
}

.brainlog{
  max-height:180px;
  overflow:auto;
  margin-top:10px;
  border-top:1px solid rgba(255,255,255,.06)
}

.logline{
  font-size:12px;
  color:#b8c9da;
  padding:7px 0;
  border-bottom:1px solid rgba(255,255,255,.05)
}

.csscandles{
  height:220px;
  background:#07111f;
  border:1px solid var(--line);
  border-radius:16px;
  padding:12px 8px;
  display:flex;
  align-items:flex-end;
  gap:5px;
  margin-top:10px;
  overflow:hidden
}

.cndl{
  position:relative;
  width:18px;
  flex:1;
  min-width:8px;
  height:100%
}

.cndl:before{
  content:"";
  position:absolute;
  left:50%;
  transform:translateX(-50%);
  width:2px;
  top:var(--wickTop);
  bottom:var(--wickBottom);
  background:var(--c)
}

.cndl:after{
  content:"";
  position:absolute;
  left:18%;
  right:18%;
  top:var(--bodyTop);
  height:var(--bodyH);
  background:var(--c);
  border-radius:2px
}

@media(max-width:430px){
  .brand{font-size:19px}
  .value{font-size:21px}
  .round{font-size:42px}
  .signal{font-size:31px}
}
</style>
</head>

<body>

