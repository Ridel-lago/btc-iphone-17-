.brand{font-size:21px;font-weight:900;letter-spacing:.2px}
.badge{font-size:12px;border:1px solid var(--line);background:#0b1726;padding:7px 10px;border-radius:999px;color:#bcd0e5}
.card{background:linear-gradient(180deg,var(--card2),var(--card));border:1px solid var(--line);border-radius:18px;padding:14px;margin:10px 0;box-shadow:0 12px 28px rgba(0,0,0,.22)}
.grid2{display:grid;grid-template-columns:1fr 1fr;gap:10px}
.label{font-size:11px;color:var(--muted);text-transform:uppercase;letter-spacing:.8px}
.value{font-size:24px;font-weight:900;margin-top:4px}
.small{font-size:13px;color:var(--muted)}
.center{text-align:center}
.round{font-size:46px;font-weight:1000;line-height:1}
.signal{font-size:34px;font-weight:1000;margin:6px 0}
.wait{color:var(--yellow)} .up{color:var(--green)} .down{color:var(--red)}
.probs{display:grid;grid-template-columns:1fr 1fr;gap:10px;margin-top:12px}
.prob{border-radius:16px;padding:13px;border:1px solid var(--line);background:#0a1625}
.prob .n{font-size:32px;font-weight:1000}
.bar{height:9px;background:#16283c;border-radius:999px;overflow:hidden;margin-top:8px}
.fill{height:100%;border-radius:999px}
.upfill{background:var(--green)} .downfill{background:var(--red)}
.earlybox{margin:12px 0 2px;padding:14px;border-radius:16px;border:1px solid #2f7f67;background:#0c2a24;text-align:center}
.earlytitle{font-size:12px;color:#9de8ca;text-transform:uppercase;letter-spacing:1px;font-weight:900}
.earlysignal{font-size:28px;font-weight:1000;margin-top:5px}
.earlymeta{font-size:13px;color:#b7d7ca;margin-top:5px}
.confirm{padding:12px;border-radius:14px;border:1px solid #42516a;background:#121c2a;font-weight:900;text-align:center;font-size:19px}
.row{display:flex;justify-content:space-between;gap:8px;align-items:center;padding:9px 0;border-bottom:1px solid rgba(255,255,255,.06)}
.row:last-child{border-bottom:0}
.pill{font-size:12px;padding:5px 8px;border-radius:999px;background:#13263a;color:#c8d8e8}
.actions{display:grid;grid-template-columns:1fr 1fr;gap:9px;margin-top:10px}
button{border:0;border-radius:14px;padding:13px 10px;font-weight:850;font-size:15px;background:#17304a;color:white}
button.primary{background:#1a6fd1}
button.good{background:#145d45}
button.bad{background:#7d2630}
.memory{display:grid;grid-template-columns:repeat(4,1fr);gap:8px}
.stat{background:#0a1625;border:1px solid var(--line);border-radius:14px;padding:11px;text-align:center}
.stat b{display:block;font-size:22px;margin-top:3px}
.alert{border:1px solid #6a5521;background:#2c240f;color:#ffe7a5;border-radius:14px;padding:10px 12px;font-size:13px}
.footer{font-size:11px;color:#71879e;text-align:center;margin-top:14px}
@media(max-width:430px){
  .brand{font-size:19px}
  .value{font-size:21px}
  .round{font-size:42px}
  .signal{font-size:31px}
}
.charthead{display:flex;justify-content:space-between;align-items:center;gap:8px}
.charttrend{font-weight:900;font-size:13px}
.bookgrid{display:grid;grid-template-columns:1fr 1fr;gap:8px;margin-top:10px}
.bookitem{background:#0a1625;border:1px solid var(--line);border-radius:13px;padding:10px}
.bookitem b{display:block;font-size:13px;margin-bottom:3px}
.bookitem span{font-size:11px;color:var(--muted)}
.brainlog{max-height:180px;overflow:auto;margin-top:10px;border-top:1px solid rgba(255,255,255,.06)}
.logline{font-size:12px;color:#b8c9da;padding:7px 0;border-bottom:1px solid rgba(255,255,255,.05)}
.refchart{position:relative;height:300px;background:#07111f;border:1px solid var(--line);border-radius:16px;margin-top:10px;overflow:hidden;padding:0}
.refchart svg{width:100%;height:100%;display:block}
.leveltag{font-size:10px;font-weight:900;fill:#fff}
.flagpanel{display:grid;grid-template-columns:1fr 1fr;gap:8px;margin-top:10px}
.flagbtn{border-radius:13px;padding:11px 10px;text-align:center;font-weight:900;border:1px solid var(--line);box-shadow:inset 0 0 18px rgba(255,255,255,.03)}
.flagbtn small{display:block;font-size:11px;font-weight:600;margin-top:3px;opacity:.85}
.flagup{background:#0c2a24;border-color:#23d18b;color:#8df0c9}
.flagdown{background:#30151d;border-color:#ff5f6d;color:#ff9ba4}
</style>
