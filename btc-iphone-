<script>
let voiceOn = true;
let lastResult = null;

function speak() {
  if (!voiceOn || !lastResult || !("speechSynthesis" in window)) return;

  const r = lastResult;

  const texto =
    `Kalshi Bitcoin quince minutos. ` +
    `${r.signal}. ` +
    `Up ${Math.round(r.up)} por ciento. ` +
    `Down ${Math.round(r.down)} por ciento. ` +
    `Bitcoin está ${Math.abs(Math.round(r.dist))} dólares ` +
    `${r.dist >= 0 ? "arriba" : "abajo"} del objetivo.`;

  const voz = new SpeechSynthesisUtterance(texto);

  voz.lang = "es-US";
  voz.rate = 1;
  voz.pitch = 1;
  voz.volume = 1;

  speechSynthesis.cancel();
  speechSynthesis.speak(voz);
}

const voiceButton = document.getElementById("voice");

if (voiceButton) {
  voiceButton.onclick = function () {
    voiceOn = !voiceOn;

    voiceButton.textContent = voiceOn
      ? "🔊 Voz activada cada minuto"
      : "🔇 Activar lectura por voz";

    if (voiceOn) {
      speak();
    } else {
      speechSynthesis.cancel();
    }
  };
}

/* Lee automáticamente cada minuto */
setInterval(function () {
  if (voiceOn) {
    speak();
  }
}, 60000);

/* Ayuda a mantener la voz funcionando en iPhone/Safari */
document.addEventListener("visibilitychange", function () {
  if (!document.hidden && voiceOn) {
    speechSynthesis.resume();
  }
});
</script>